{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --include=optional",
  "redirects": [
    {
      "source": "/my-study-desk",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/my-study-desk/",
      "destination": "/",
      "permanent": true
    }
  ]
}
