# Cloud Functions runtime configuration. Copy to functions/.env for local emulation
# or set these non-secret values in the deployed Functions environment.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-flash-lite
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Never put provider API keys or AI_CONFIG_ENCRYPTION_KEY in this file.
# Configure AI_CONFIG_ENCRYPTION_KEY as a Firebase Functions secret, then set
# the provider API key through the protected Admin Panel.

# Existing credit and XP defaults remain configurable; payment fulfillment stays disabled.
CREDIT_COST_AI_MOCK=8
CREDIT_COST_NOTES_MOCK=10
CREDIT_COST_NOTES_EXTRACT=4
CREDIT_COST_COACHING_PARSE=6
CREDIT_COST_QUESTION_BANK=8
CREDIT_COST_ANALYSIS=3
CREDIT_COST_BACKLOG_INSIGHTS=2
XP_PER_CORRECT=10
XP_TEST_COMPLETION=15

# Public Supabase project settings used by the Auth token exchange endpoint.
SUPABASE_URL=https://icgbufofhubjnrekedoa.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_CVWGeQ2kx_zx0u58G9TeMw_64VEx55k
